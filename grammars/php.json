{
  "scopeName": "source.php",
  "type": "tree-sitter",
  "parser": "tree-sitter-php",
  // Internal PHP is an exact target, distinct from the root HTML/PHP grammar.
  "injectionNames": ["internal-php"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-php/php#v0.24.2",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "php.wasm",
    "highlightsQuery": "php-shared-highlights.scm",
    "tagsQuery": "php-shared-tags.scm",
    "foldsQuery": "php-shared-folds.scm",
    "indentsQuery": "php-shared-indents.scm"
  }
}
